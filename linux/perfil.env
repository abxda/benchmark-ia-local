# Perfil de esta maquina (ver ETHOS.md: todo resultado lleva su perfil de hardware).
# Desktop: AMD Ryzen Threadripper 3990X (64c/128t) - 256 GB DDR4 - RTX 3060 12 GB - Ubuntu 26.04
# Rol segun ETHOS: explorar/acelerar (proxy agil de laptop). NO decide recomendaciones:
# esas salen del perfil de referencia laptop-inegi-ultra5-32gb-1dimm.
export BENCH_PROFILE=desktop-tr3990x-rtx3060-12gb-cuda
export BENCH_RSCRIPT=/usr/bin/Rscript
# rbin/ contiene SOLO symlinks a R y Rscript: bench_zero.py antepone este dir al PATH
# y si fuera /usr/bin taparia el python del venv (python3 del sistema sin pandas).
export BENCH_R_BIN=/mnt/data_4tb/IA-Local/benchmark-ia-local/linux/rbin
export BENCH_ZERO="$HOME/.npm-global/bin/zero"
export R_LIBS_USER="$HOME/R/library"

# El agente ejecuta 'python' a secas: debe resolver al venv (pandas, plotly, etc.).
export PATH="/mnt/data_4tb/IA-Local/benchmark-ia-local/.venv/bin:$PATH"

# Rutas locales del stack
export LLAMA_BIN=/mnt/data_4tb/IA-Local/llama.cpp/build/bin
export MODELOS=/mnt/data_4tb/IA-Local/benchmark-ia-local/llama_cpp
export VENV_PY=/mnt/data_4tb/IA-Local/benchmark-ia-local/.venv/bin/python
